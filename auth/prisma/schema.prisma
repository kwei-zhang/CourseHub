// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth schema: email/password + Google OAuth ---
// One User can sign in via email+password (Credential) and/or Google (Account).

model User {
  id            String    @id @default(cuid())
  email         String?   @unique // from sign-up or OAuth (Google provides it)
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("user")

  credential Credential?
  accounts   Account[]
  sessions   Session[]
}

/// Email/password login: one hashed password per user (optional).
model Credential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   // e.g. bcrypt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// OAuth providers (e.g. Google). One row per provider per user.
model Account {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String    // "google"
  providerAccountId String    // e.g. Google's "sub"
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, providerAccountId])
}

/// Sessions for "remember me" / token-based auth (optional).
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
