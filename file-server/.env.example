# Database (required for Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=files"

# DigitalOcean Spaces (S3-compatible) – required for file storage
SPACES_BUCKET=your-spaces-bucket-name
SPACES_KEY=your-spaces-access-key-id
SPACES_SECRET=your-spaces-secret-access-key

# Optional: region and endpoint (defaults: tor1, https://tor1.digitaloceanspaces.com)
# SPACES_REGION=tor1
# SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com

# Optional: server
# PORT=5002
# USER_SERVER=localhost:5001
# PROTO_PATH=../../proto/services.proto
